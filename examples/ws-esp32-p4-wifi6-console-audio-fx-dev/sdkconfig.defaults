# ============================================================================
# ESP32-P4 Hardware Target Configuration
# ============================================================================
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y

# ============================================================================
# Flash Configuration (32 MB)
# ============================================================================
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# ============================================================================
# Dedicated test-app partition table and local WAV filesystem
# ============================================================================
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_SPIFFS_MAX_PARTITIONS=2
CONFIG_SPIFFS_OBJ_NAME_LEN=32

# ============================================================================
# All effects are available for interactive listening tests
# ============================================================================
CONFIG_AUDIO_FX_ENABLE_REVERB=y
CONFIG_AUDIO_FX_ENABLE_CHORUS=y
CONFIG_AUDIO_FX_ENABLE_EQUALIZER=y
CONFIG_AUDIO_FX_ENABLE_DELAY=y
CONFIG_AUDIO_FX_ENABLE_FLANGER=y
CONFIG_AUDIO_FX_ENABLE_BITCRUSHER=y
CONFIG_AUDIO_FX_ENABLE_COMPRESSOR=y
CONFIG_AUDIO_FX_ENABLE_LIMITER=y
