# ============================================================================
# ESP32-P4 Hardware Target Configuration
# ============================================================================
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y

# ============================================================================
# Flash Configuration (32 MB)
# ============================================================================
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# ============================================================================
# Exercise every effect in the unit-test app
# ============================================================================
CONFIG_AUDIO_FX_ENABLE_REVERB=y
CONFIG_AUDIO_FX_ENABLE_CHORUS=y
CONFIG_AUDIO_FX_ENABLE_EQUALIZER=y
CONFIG_AUDIO_FX_ENABLE_DELAY=y
CONFIG_AUDIO_FX_ENABLE_FLANGER=y
CONFIG_AUDIO_FX_ENABLE_BITCRUSHER=y
CONFIG_AUDIO_FX_ENABLE_COMPRESSOR=y
CONFIG_AUDIO_FX_ENABLE_LIMITER=y
